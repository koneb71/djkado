# ---- Spotify (optional; leave empty to use the built-in mock source) ----
# Create an app at https://developer.spotify.com/dashboard and add this exact redirect URI:
#   http://127.0.0.1:5173/callback/spotify
# Web Playback SDK requires Spotify Premium.
VITE_SPOTIFY_CLIENT_ID=
# Defaults to <current origin>/callback/spotify (web: 127.0.0.1:5173, desktop: 127.0.0.1:47831) — register both in the dashboard.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback/spotify

# ---- Apple Music (optional; leave empty to use the built-in mock source) ----
# Desktop app: configure these in Settings ▸ Desktop instead (stored in the app data folder).
# Requires an Apple Developer Program membership + a MusicKit private key (.p8).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# API server port (Vite proxies /api here)
PORT=8787
