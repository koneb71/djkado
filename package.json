{
  "name": "djkado",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "description": "DJKado — a VirtualDJ-style browser DJ app with a hybrid local/streaming engine",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "node server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "cross-env STATIC_DIR=dist node dist-server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "dev:desktop": "cross-env ELECTRON=1 vite",
    "build:desktop": "tsc -b && cross-env ELECTRON=1 vite build",
    "dist:mac": "pnpm build:desktop && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:win": "pnpm build:desktop && electron-builder --win --publish never",
    "dist": "pnpm build:desktop && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --win --publish never",
    "release": "pnpm build:desktop && electron-builder --mac --win --publish always",
    "icons": "node scripts/gen-icon.mjs",
    "android:sync": "vite build && cap sync android",
    "android:build": "pnpm android:sync && cd android && ./gradlew assembleDebug -q && ls -la app/build/outputs/apk/debug/",
    "android:release": "pnpm android:sync && cd android && ./gradlew assembleRelease -q",
    "android:open": "cap open android",
    "android:run": "pnpm android:sync && cap run android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.17.0",
    "@hono/node-server": "^1.13.7",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-virtual": "^3.11.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/audioworklet": "^0.0.65",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "hono": "^4.6.14",
    "idb": "^8.0.1",
    "jose": "^5.9.6",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "music-metadata": "^10.6.4",
    "onnxruntime-web": "^1.27.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hotkeys-hook": "^4.6.1",
    "sharp": "^0.35.3",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^3.2.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "electron-updater": "^6.8.9"
  },
  "main": "dist-electron/main.js",
  "repository": "github:koneb71/djkado",
  "author": "koneb71",
  "homepage": "https://github.com/koneb71/djkado",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0"
}
